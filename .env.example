# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Used outside Docker with a reachable Postgres; URL-encode its password.
# Compose uses its own password-free URL and passes POSTGRES_PASSWORD via PGPASSWORD.
DATABASE_URL=postgresql://chhaaya:change-me@localhost:5432/chhaaya

# WhatsApp Cloud API (see the README). WHATSAPP_VERIFY_TOKEN is any string you choose.
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Claude handles text, language identification and OCR by default.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Gemini is the manual fallback (AI_PROVIDER=gemini) and optional speech provider.
GEMINI_API_KEY=
# Speech is deferred. Set true with GEMINI_API_KEY to restore the existing voice path.
SPEECH_ENABLED=false
# Only for `docker compose --profile tunnel up`.
CLOUDFLARE_TUNNEL_TOKEN=
